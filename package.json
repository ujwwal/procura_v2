{
  "name": "procura-procurement-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Local full-stack procurement sandbox with Express and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "n8n:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File automation/n8n/setup.ps1",
    "n8n:start": "powershell -NoProfile -ExecutionPolicy Bypass -File automation/n8n/start.ps1",
    "n8n:version": "powershell -NoProfile -ExecutionPolicy Bypass -File automation/n8n/start.ps1 --version",
    "db:setup": "node db/setup.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "test:invoice": "node --test tests/invoice-explainer.test.js",
    "invoice:workflow": "node automation/n8n/build-invoice-workflow.js",
    "invoice:eval": "node scripts/evaluate-invoice-explainer.js",
    "test:approval": "node --test tests/approval-review.test.js",
    "approval:workflow": "node automation/n8n/build-approval-workflow.js",
    "approval:eval": "node scripts/evaluate-approval-review.js",
    "test:quote": "node --test tests/quote-extractor.test.js",
    "quote:workflow": "node automation/n8n/build-quote-workflow.js",
    "quote:eval": "node scripts/evaluate-quote-extractor.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18"
  }
}
